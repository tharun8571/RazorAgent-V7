# RazorAgent V7 - Environment Configuration Template
# Copy this file to backend/.env and frontend/.env.local (if needed)

# Application & Environment Mode
ENVIRONMENT=development
APP_NAME="RazorAgent V7"
DEBUG=true
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# LLM Intelligence Engine (Groq LPUs)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.1
GROQ_TIMEOUT_SECONDS=15

# LangSmith Observability & Distributed Tracing
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your_langsmith_api_key_here
LANGSMITH_PROJECT=razoragent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Razorpay Sandbox Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_TEST_MODE=true

# Persistence & In-Memory Redis Stream
DATABASE_URL=sqlite+aiosqlite:///./razoragent.db
REDIS_URL=redis://localhost:6379/0

# Deterministic Hard Safety Guardrails & Risk Thresholds
MAX_TRANSACTION_AMOUNT_INR=500000.0
MAX_AUTO_RETRIES=3
HIGH_RISK_THRESHOLD=0.75
IDEMPOTENCY_EXPIRY_SECONDS=86400
